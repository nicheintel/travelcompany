# Keep code, settings, database files and leftovers (old zips, backups) private
Options -Indexes
ServerSignature Off
<FilesMatch "(^\.|^config\.local.*\.php$|\.(sql|md|log|txt|json|ini|sh|bat|zip|tar|gz|tgz|rar|7z|bak|old|orig|save|swp|tmp|dist|env|lock|yml|yaml)$|~$)">
    Require all denied
</FilesMatch>
<FilesMatch "^robots\.txt$">
    Require all granted
</FilesMatch>

# Always use https
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # Only normal page requests: block odd methods (TRACE etc.)
    RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD)$
    RewriteRule ^ - [F]
</IfModule>

# Speed: browsers keep images, fonts, styles and scripts for a year (file names change when they do),
# and pages, styles and scripts are sent compressed.
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpe?g|png|svg|ico|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Security policy (same as the one the PHP pages send). Set here with "always" so Hostinger's own one-line
# "upgrade-insecure-requests" policy from Force HTTPS can't replace it; upgrade-insecure-requests is included.
<IfModule mod_headers.c>
    Header unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
    # Documents (doc.php): shown in this site's own pop-up viewer, so they may be framed by this site only
    <Files "doc.php">
        Header always set Content-Security-Policy "frame-ancestors 'self'"
    </Files>
</IfModule>
