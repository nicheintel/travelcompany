# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database
/data/

# PHP version: local settings and runtime files
/php/config.local.php
/php/storage/*.log
/php/storage/*.log.php
/php/storage/schema-*
/php/storage/*.json
/php/storage/*.txt
/php/uploads/*
!/php/uploads/.htaccess
!/php/uploads/.gitkeep

# LamazonLoads (XAMPP) site: local settings and runtime files
/lamazonloads/site/config.local.php
/lamazonloads/site/storage/schema-*
/lamazonloads/site/uploads/*
!/lamazonloads/site/uploads/.htaccess
!/lamazonloads/site/uploads/.gitkeep
/lamazonloads/site/storage/mail/
/lamazonloads/site/storage/disposable_domains.txt*
/lamazonloads/site/media/*
!/lamazonloads/site/media/.htaccess
!/lamazonloads/site/media/.gitkeep
